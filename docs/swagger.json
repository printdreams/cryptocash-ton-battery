{
    "swagger": "2.0",
    "info": {
        "description": "Backend service for the Cryptocash Battery on the TON network.",
        "title": "Battery implementation for TON network",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/firebase/status": {
            "get": {
                "description": "Verifies the Firestore connection with a live round-trip and reports whether Firebase is reachable",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "firebase"
                ],
                "summary": "Firebase connection status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Returns OK status if the API is running",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Check service status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    }
}